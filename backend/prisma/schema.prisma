// NCAGP - National Cyber Audit Governance Platform
// Prisma Schema v1.0 - Steel Thread
// Data Residency: India Only | Encrypted at Rest | Row-Level Security

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────
// FEDERATION & MULTI-TENANCY
// ─────────────────────────────────────────────────────

enum OrgType {
  NIC        // Root authority — sees everything
  DEPARTMENT // Govt ministry/dept — sees self + vendors
  VENDOR     // Audit firm — sees assigned audits only
}

model Organization {
  id                String   @id @default(uuid())
  name              String
  shortCode         String   @unique // e.g. "MHA", "MOF", "NIC"
  orgType           OrgType
  parentOrgId       String?
  parentOrg         Organization?  @relation("OrgHierarchy", fields: [parentOrgId], references: [id])
  childOrgs         Organization[] @relation("OrgHierarchy")
  encryptionDomain  String   // KMS key domain per org
  dataAccessScope   String[] // which org_ids this org can see
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users             User[]
  assets            Asset[]
  auditsOwned       Audit[]  @relation("AuditOwner")
  auditsVendored    Audit[]  @relation("AuditVendor")
  findings          Finding[]
  vendor            Vendor?

  @@index([orgType])
  @@map("organizations")
}

// ─────────────────────────────────────────────────────
// IDENTITY & ACCESS MANAGEMENT
// ─────────────────────────────────────────────────────

enum UserRole {
  NIC_ADMIN       // Full system access
  DEPT_CISO       // Department head — full dept visibility
  DEPT_SECURITY   // Department security officer
  VENDOR_ADMIN    // Vendor lead auditor
  AUDITOR         // Individual auditor
  REVIEWER        // Read-only with comment rights
  OBSERVER        // Pure read-only
}

model User {
  id            String    @id @default(uuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  email         String    @unique
  name          String
  role          UserRole
  passwordHash  String    // bcrypt, cost factor 12+
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?   // TOTP secret, encrypted
  mfaBackupCodes String[]  // Hashed one-time backup codes
  publicKey     String?   // For digital signatures on critical actions
  lastLoginAt   DateTime?
  failedAttempts Int      @default(0)
  lockedUntil   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  tasksAssigned Task[]    @relation("TaskAssignee")
  tasksCreated  Task[]    @relation("TaskCreator")
  evidenceUploaded Evidence[]
  ledgerEvents  AuditLedger[]
  findings      Finding[] @relation("FindingOwner")

  @@index([orgId])
  @@index([email])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  token        String   @unique // hashed JWT ID
  ipAddress    String
  userAgent    String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────
// ASSET REGISTER
// ─────────────────────────────────────────────────────

enum AssetType {
  WEB_APPLICATION
  API_SERVICE
  DATABASE
  NETWORK_DEVICE
  SERVER
  CLOUD_RESOURCE
  IOT_DEVICE
  MOBILE_APP
  DATA_STORE
  THIRD_PARTY_INTEGRATION
}

enum AssetStatus {
  ACTIVE
  DEPRECATED
  DECOMMISSIONED
  UNDER_REVIEW
}

model Asset {
  id              String      @id @default(uuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id])
  assetType       AssetType
  name            String
  description     String?
  ownerUserId     String?
  businessUnit    String
  criticality     Int         // 1 (low) to 5 (critical)
  dataSensitivity String      // PUBLIC, INTERNAL, CONFIDENTIAL, SECRET
  environment     String      // PROD, STAGING, DEV, DR
  locationRegion  String      @default("IN") // Data residency
  ipAddress       String?
  hostname        String?
  dependencies    String[]    // asset_ids this asset depends on
  tags            String[]
  status          AssetStatus @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  auditAssets     AuditAsset[]
  findings        Finding[]
  ownerHistory    AssetOwnerHistory[]

  @@index([orgId])
  @@index([criticality])
  @@map("assets")
}

model AssetOwnerHistory {
  id            String   @id @default(uuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id])
  previousOwner String?
  newOwner      String
  changedAt     DateTime @default(now())
  changedBy     String
  reason        String?

  @@map("asset_owner_history")
}

// ─────────────────────────────────────────────────────
// CONTROL & RISK LIBRARY
// ─────────────────────────────────────────────────────

enum FrameworkType {
  ISO_27001
  NIST_CSF
  SOC2
  DPDP         // India Data Protection
  MEITY_AUDIT  // Ministry of Electronics
  CIS_CONTROLS
  PCI_DSS
}

model Control {
  id              String  @id @default(uuid())
  controlCode     String  @unique // e.g. "AC-001"
  name            String
  description     String  @db.Text
  category        String  // Access Control, Incident Mgmt, etc.
  objective       String  @db.Text
  testingGuidance String? @db.Text
  isActive        Boolean @default(true)

  frameworkMappings ControlFrameworkMapping[]
  findings          Finding[]

  @@map("controls")
}

model ControlFrameworkMapping {
  id                String        @id @default(uuid())
  controlId         String
  control           Control       @relation(fields: [controlId], references: [id])
  framework         FrameworkType
  frameworkControlId String       // e.g. "A.9.1.1" for ISO
  frameworkDomain   String        // Domain/category in that framework

  @@unique([controlId, framework, frameworkControlId])
  @@map("control_framework_mappings")
}

// ─────────────────────────────────────────────────────
// AUDIT LIFECYCLE ENGINE
// ─────────────────────────────────────────────────────

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  FINDINGS_SUBMITTED
  REMEDIATION
  VALIDATION
  CLOSED
  CANCELLED
}

model Audit {
  id            String      @id @default(uuid())
  orgId         String      // Department being audited
  org           Organization @relation("AuditOwner", fields: [orgId], references: [id])
  vendorOrgId   String?     // Vendor conducting audit
  vendorOrg     Organization? @relation("AuditVendor", fields: [vendorOrgId], references: [id])
  framework     FrameworkType
  title         String
  scope         String      @db.Text
  objectives    String      @db.Text
  startDate     DateTime
  endDate       DateTime
  status        AuditStatus @default(PLANNED)
  auditLeadId   String?
  reportRef     String?     // Final report storage reference
  closedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  auditAssets   AuditAsset[]
  findings      Finding[]

  @@index([orgId])
  @@index([status])
  @@map("audits")
}

model AuditAsset {
  auditId   String
  audit     Audit  @relation(fields: [auditId], references: [id])
  assetId   String
  asset     Asset  @relation(fields: [assetId], references: [id])
  addedAt   DateTime @default(now())

  @@id([auditId, assetId])
  @@map("audit_assets")
}

// ─────────────────────────────────────────────────────
// FINDINGS ENGINE — CORE MOAT
// ─────────────────────────────────────────────────────

enum Severity {
  CRITICAL  // P0 — Immediate action, breach risk
  HIGH      // P1 — 24hr SLA
  MEDIUM    // P2 — 7-day SLA
  LOW       // P3 — 30-day SLA
  INFO      // Informational only
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  IN_REMEDIATION
  REMEDIATED_PENDING_VALIDATION
  VALIDATED
  CLOSED
  RISK_ACCEPTED       // Formally accepted with justification
  FALSE_POSITIVE      // Disputed and confirmed FP
}

model Finding {
  id              String        @id @default(uuid())
  auditId         String
  audit           Audit         @relation(fields: [auditId], references: [id])
  orgId           String        // Which department this belongs to
  org             Organization  @relation(fields: [orgId], references: [id])
  assetId         String?
  asset           Asset?        @relation(fields: [assetId], references: [id])
  controlId       String?
  control         Control?      @relation(fields: [controlId], references: [id])
  
  severity        Severity
  title           String
  description     String        @db.Text
  rootCause       String?       @db.Text
  recommendation  String?       @db.Text
  technicalDetail String?       @db.Text
  
  status          FindingStatus @default(OPEN)
  ownerId         String?       // Dept user responsible for fix
  owner           User?         @relation("FindingOwner", fields: [ownerId], references: [id])
  
  // SLA tracking
  slaDate         DateTime?     // Auto-set based on severity
  slaBreached     Boolean       @default(false)
  
  // Closure tracking
  closedAt        DateTime?
  closureJustification String?  @db.Text
  riskAcceptedBy  String?
  riskAcceptedAt  DateTime?
  
  isRecurring     Boolean       @default(false)
  previousFindingId String?     // Link to prior occurrence
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  evidence        Evidence[]
  tasks           Task[]
  statusHistory   FindingStatusHistory[]

  @@index([orgId])
  @@index([auditId])
  @@index([severity])
  @@index([status])
  @@index([slaDate])
  @@map("findings")
}

model FindingStatusHistory {
  id          String        @id @default(uuid())
  findingId   String
  finding     Finding       @relation(fields: [findingId], references: [id])
  fromStatus  FindingStatus?
  toStatus    FindingStatus
  changedBy   String
  changedAt   DateTime      @default(now())
  comment     String?

  @@map("finding_status_history")
}

// ─────────────────────────────────────────────────────
// EVIDENCE ENGINE — IMMUTABLE
// ─────────────────────────────────────────────────────

enum EvidenceType {
  SCREENSHOT
  LOG_FILE
  CONFIGURATION_EXPORT
  POLICY_DOCUMENT
  SCAN_REPORT
  TEST_RESULT
  CERTIFICATE
  VIDEO_RECORDING
  CODE_SNIPPET
  OTHER
}

model Evidence {
  id               String       @id @default(uuid())
  findingId        String
  finding          Finding      @relation(fields: [findingId], references: [id])
  
  evidenceType     EvidenceType
  fileName         String
  fileSize         Int          // bytes
  mimeType         String
  
  // Immutability guarantees
  sha256Hash       String       // SHA-256 of raw file bytes
  storageRef       String       // Object store path (S3/MinIO)
  storageRegion    String       @default("ap-south-1") // India region
  
  // Non-repudiation
  uploadedById     String
  uploadedBy       User         @relation(fields: [uploadedById], references: [id])
  uploadedAt       DateTime     @default(now())
  digitalSignature String?      // Uploader's signature of hash
  
  description      String?      // What does this evidence prove?
  
  // Superseding (no deletion ever)
  isSuperseded     Boolean      @default(false)
  supersededById   String?      // Points to newer evidence
  supersededAt     DateTime?
  supersessionReason String?

  @@index([findingId])
  @@map("evidence")
}

// ─────────────────────────────────────────────────────
// WORKFLOW & REMEDIATION ENGINE
// ─────────────────────────────────────────────────────

enum TaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
  OVERDUE
}

model Task {
  id            String     @id @default(uuid())
  findingId     String
  finding       Finding    @relation(fields: [findingId], references: [id])
  title         String
  description   String?    @db.Text
  assignedToId  String
  assignedTo    User       @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById   String
  createdBy     User       @relation("TaskCreator", fields: [createdById], references: [id])
  status        TaskStatus @default(PENDING)
  dueDate       DateTime
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([assignedToId])
  @@index([findingId])
  @@map("tasks")
}

// ─────────────────────────────────────────────────────
// VENDOR MANAGEMENT SYSTEM
// ─────────────────────────────────────────────────────

model Vendor {
  id                  String       @id @default(uuid())
  orgId               String       @unique
  org                 Organization @relation(fields: [orgId], references: [id])
  
  registrationNumber  String?      // Govt registration
  certifications      String[]     // ISO, CREST, etc.
  empanelmentDate     DateTime?
  empanelmentExpiry   DateTime?
  
  // Computed KPI scores (updated nightly)
  trustScore          Float        @default(0) // 0-100
  qualityScore        Float        @default(0)
  onTimeDeliveryPct   Float        @default(0)
  falsePositiveRate   Float        @default(0)
  recurringFindingsRate Float      @default(0)
  slaCompliancePct    Float        @default(0)
  evidenceQualityScore Float       @default(0)
  
  isBlacklisted       Boolean      @default(false)
  blacklistReason     String?
  blacklistedAt       DateTime?
  blacklistedBy       String?
  
  totalAudits         Int          @default(0)
  totalFindings       Int          @default(0)
  
  updatedAt           DateTime     @updatedAt

  @@map("vendors")
}

// ─────────────────────────────────────────────────────
// IMMUTABLE AUDIT LEDGER — TAMPER-EVIDENT
// ─────────────────────────────────────────────────────
// Hash chain: each entry includes SHA-256(prev_hash + current_event_data)
// Breaking the chain = proof of tampering
// Court-grade evidentiary record

enum LedgerEventType {
  // Auth events
  USER_LOGIN
  USER_LOGOUT
  USER_MFA_BYPASS_ATTEMPT
  USER_LOCKED
  
  // Org events
  ORG_CREATED
  ORG_MODIFIED
  
  // Audit events
  AUDIT_CREATED
  AUDIT_STATUS_CHANGED
  AUDIT_CLOSED
  
  // Finding events
  FINDING_CREATED
  FINDING_STATUS_CHANGED
  FINDING_SEVERITY_CHANGED
  FINDING_OWNER_CHANGED
  FINDING_RISK_ACCEPTED
  FINDING_FALSE_POSITIVE
  
  // Evidence events
  EVIDENCE_UPLOADED
  EVIDENCE_SUPERSEDED
  EVIDENCE_INTEGRITY_CHECK
  
  // Task events
  TASK_CREATED
  TASK_ASSIGNED
  TASK_COMPLETED
  
  // Vendor events
  VENDOR_SCORED
  VENDOR_BLACKLISTED
  
  // System events
  BULK_IMPORT
  REPORT_EXPORTED
  DATA_ACCESS_ANOMALY
}

model AuditLedger {
  id            String          @id @default(uuid())
  
  // Who did what
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  orgId         String
  
  // What happened
  eventType     LedgerEventType
  entityType    String          // "Finding", "Evidence", "Audit", etc.
  entityId      String          // The ID of the affected entity
  
  // Full snapshot for non-repudiation
  payload       Json            // Full event data snapshot
  ipAddress     String
  userAgent     String?
  
  // Hash chain — THE CORE
  hashPrev      String          // Hash of previous ledger entry
  hashCurrent   String          // SHA-256(hashPrev + eventType + entityId + timestamp + payload)
  
  timestamp     DateTime        @default(now())
  
  // Ledger entries are NEVER updated or deleted
  // PostgreSQL trigger enforces this at DB level

  @@index([userId])
  @@index([entityId])
  @@index([eventType])
  @@index([timestamp])
  @@map("audit_ledger")
}
